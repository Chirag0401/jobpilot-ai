# Free mode works without any API keys.
JOBPILOT_EDITION=standard

# Optional Google X-Ray search
SERPER_API_KEY=

# Optional AI providers. Set only the provider you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OPENAI_MODEL=gpt-4.1-mini
CLAUDE_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash
