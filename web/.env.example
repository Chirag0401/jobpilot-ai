# Supabase enables email sign-in and private saved jobs.
# Leave these unset for read-only public job browsing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase projects may use this key instead (not required if above is set):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ONLY use the Supabase publishable / anon public key above.
# NEVER add a service_role key, sb_secret key, or database password to NEXT_PUBLIC_.
# OpenAI, Anthropic, Gemini keys are entered by individual users at runtime,
# and are not stored in this app's database or environment.
